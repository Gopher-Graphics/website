{
  "scripts": {
    "build": "zola build $BUILD_OPTS && npx @tailwindcss/cli -i ./static/pretailwind.css -o ./public/style.css -m",
    "serve": "zola serve $SERVE_OPTS --interface 127.0.0.1 & npx @tailwindcss/cli -i ./static/pretailwind.css -o ./public/style.css --watch && wait",
    "test": "zola serve & export ZOLA_PID=$! && npx @tailwindcss/cli -i ./static/pretailwind.css -o ./public/style.css && sleep 3 && npx pa11y-ci --config pa11y-conf.json && kill $ZOLA_PID"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "pa11y-ci": "^4.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
